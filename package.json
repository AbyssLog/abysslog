{
  "name": "abysslog",
  "version": "1.1.6",
  "description": "EVE Online Abyssal Deadspace run tracker",
  "author": "Erinys",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AbyssLog/abysslog.git"
  },
  "bugs": {
    "url": "https://github.com/AbyssLog/abysslog/issues"
  },
  "homepage": "https://github.com/AbyssLog/abysslog#readme",
  "main": "src/main/main.js",
  "scripts": {
    "setup": "node scripts/setup-electron.js",
    "check": "npm run check:architecture && npm test",
    "check:architecture": "node scripts/check-architecture.js",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "start": "electron .",
    "build:win": "electron-builder --win --publish never",
    "build:win:release": "electron-builder --win nsis --x64 --publish never",
    "build:mac": "electron-builder --mac --publish never",
    "build:linux": "electron-builder --linux --publish never",
    "build:all": "electron-builder --win --mac --linux --publish never",
    "test:package:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-test-windows-package.ps1",
    "release:verify": "node scripts/verify-release-tag.js",
    "release:checksums": "node scripts/create-release-checksums.js"
  },
  "build": {
    "appId": "com.abysslog.app",
    "productName": "AbyssLog",
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "AbyssLog",
      "repo": "abysslog"
    },
    "protocols": {
      "name": "AbyssLog",
      "schemes": [
        "eveauth-abysslog"
      ]
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "package.json",
      "LICENSE",
      "NOTICE.md"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "loadBrowserProcessSpecificV8Snapshot": false,
      "grantFileProtocolExtraPrivileges": false
    },
    "npmRebuild": false
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.0.1"
  }
}
